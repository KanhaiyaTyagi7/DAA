#include <stdio.h>

int max(int a, int b) {
	return (a > b) ? a : b;
}

int main() {
	int n, w;

	if (scanf("%d", &n) != 1) return 0;
	int values[n];
	int weights[n];

	for (int i = 0; i < n; i++) {
		scanf("%d", &values[i]);
	}

	for (int i = 0; i < n; i++) {
	    scanf("%d", &weights[i]);
	}
	scanf("%d", &w);

	int dp[w + 1];

	for (int j = 0; j <= w; j++) {
		dp[j] = 0;
	}

	for (int i = 0; i < n; i++) {
		for (int j = w; j >= weights[i]; j--) {
			dp[j] = max(dp[j], dp[j - weights[i]] + values[i]);
		}
	}

	printf("%d\n", dp[w]);

	return 0;
}
