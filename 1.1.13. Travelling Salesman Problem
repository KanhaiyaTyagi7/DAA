#include <stdio.h>
#include <limits.h>
#define INF 1e9
int n;
int dist[20][20];
int dp[1 << 16][16];
int min(int a, int b) {
	return (a < b) ? a : b;
}
int tsp(int mask, int pos) {
	if (mask == (1 << n) - 1) {
		return (dist[pos][0] != -1) ? dist[pos][0] : INF;
	}
	if (dp[mask][pos] != -1) {
		return dp[mask][pos];
	}

	int ans = INF;
	for (int city = 0; city < n; city++) {
		if ((mask & (1 << city)) == 0 && dist[pos][city] != -1) {
			int newCost = dist[pos][city] + tsp(mask | (1 << city), city);
			ans = min(ans, newCost);
		}
	}
	return dp[mask][pos] = ans;
}
int main() {
	if (scanf("%d", &n) != 1) return 0;
	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n; j++) {
			scanf("%d", &dist[i][j]);
		}
	}
	for (int i = 0; i < (1 << n); i++) {
		for (int j = 0; j < n; j++) {
			dp[i][j] = -1;
		}
	}
	int result = tsp(1, 0);
	printf("%d\n", result);
	
	return 0;
}
