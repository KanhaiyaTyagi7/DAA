#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

void kruskalMST(int **cost, int V) {
    int parent[100];
    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int edge_count = 0;
    int total_min_cost = 0;

    while (edge_count < V - 1) {
        int min = 9999;
        int u = -1, v = -1;

        for (int i = 0; i < V; i++) {
            for (int j = i + 1; j < V; j++) {
                if (cost[i][j] < min) {
                    min = cost[i][j];
                    u = i;
                    v = j;
                }
            }
        }

        if (u != -1 && v != -1) {
            int x = u;
            while (parent[x] != x) {
                x = parent[x];
            }

            int y = v;
            while (parent[y] != y) {
                y = parent[y];
            }

            if (x != y) {
                printf("Edge %d:(%d, %d) cost:%d\n", edge_count, u, v, min);
                total_min_cost += min;
                parent[x] = y;
                edge_count++;
            }

            cost[u][v] = 9999;
            cost[v][u] = 9999;
        } else {
            break;
        }
    }

    printf("Minimum cost= %d\n", total_min_cost);
}




int main() {
    int V;
    printf("No of vertices: ");
    scanf("%d", &V);

    int **cost = (int **)malloc(V * sizeof(int *));
    for (int i = 0; i < V; i++)
        cost[i] = (int *)malloc(V * sizeof(int));

    printf("Adjacency matrix:\n");
    for (int i = 0; i < V; i++)
        for (int j = 0; j < V; j++)
            scanf("%d", &cost[i][j]);

    kruskalMST(cost, V);

    for (int i = 0; i < V; i++)
        free(cost[i]);
    free(cost);

    return 0;
}
